# Copy to .env or a systemd EnvironmentFile; never commit real secrets.
LOCAL_AI_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_AI_MODEL=/AI/models/qwen3.6-q4/Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
LOCAL_AI_VAR_DIR=/AI/var/local-ai-assistant
LOCAL_AI_DOCUMENT_DIR=/AI/var/local-ai-assistant/documents
LOCAL_AI_RAG_DATA_DIR=/AI/var/local-ai-assistant/rag
LOCAL_AI_CODE_REPO_DIR=/AI/var/local-ai-assistant/repos
LOCAL_AI_CODE_INDEX_DIR=/AI/var/local-ai-assistant/code-index
LOCAL_AI_PATCH_DIR=/AI/var/local-ai-assistant/patches
LOCAL_AI_CONTEXT_SIZE=262144
LOCAL_AI_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_AI_EMBEDDING_DEVICE=cpu
LOCAL_AI_EMBEDDING_BATCH_SIZE=32
LOCAL_AI_RAG_CHUNK_SIZE=450
LOCAL_AI_RAG_CHUNK_OVERLAP=75
LOCAL_AI_RAG_VECTOR_TOP_K=10
LOCAL_AI_RAG_BM25_TOP_K=10
LOCAL_AI_RAG_FINAL_TOP_K=5
LOCAL_AI_CODE_CHUNK_LINES=120
LOCAL_AI_CODE_CHUNK_OVERLAP=20
LOCAL_AI_CODE_VECTOR_TOP_K=12
LOCAL_AI_CODE_BM25_TOP_K=12
LOCAL_AI_CODE_FINAL_TOP_K=6
LOCAL_AI_RRF_K=60
LOCAL_AI_OCR_ENABLED=true
LOCAL_AI_OCR_LANGUAGE=eng
LOCAL_AI_OCR_MIN_TEXT_LENGTH=80
LOCAL_AI_OCR_DPI=200
LOCAL_AI_UI_HOST=127.0.0.1
LOCAL_AI_UI_PORT=8501
LOCAL_AI_UI_HEADLESS=true
LOCAL_AI_UI_GATHER_USAGE_STATS=false
LOCAL_AI_LOG_LEVEL=INFO
LOCAL_AI_LOG_FORMAT=json
LOCAL_AI_COMMAND_TIMEOUT=900
LOCAL_AI_INSPECTION_TIMEOUT=15
LOCAL_AI_LINT_TIMEOUT=180
LOCAL_AI_TEST_TIMEOUT=900
LOCAL_AI_BUILD_TIMEOUT=900
LOCAL_AI_TOOL_STEP_TIMEOUT=120
LOCAL_AI_EXECUTION_MAX_STEPS=12
LOCAL_AI_EXECUTION_MAX_MUTATIONS=4
LOCAL_AI_EXECUTION_MAX_REPAIRS=1
LOCAL_AI_EXECUTION_MAX_REPLANS=1
