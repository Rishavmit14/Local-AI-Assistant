[Unit]
Description=Friday Local Vision Cortex (Qwen2.5-VL 3B)
# This unit is WantedBy=default.target; adding After=default.target creates a cycle.

[Service]
Type=simple
TimeoutStartSec=300s
WorkingDirectory=VISION_MODEL_DIR
ExecStart=LLAMA_CPP_DIR/build/bin/llama-server \
  -m VISION_MODEL_PATH \
  --mmproj VISION_MMPROJ_PATH \
  --alias friday-vision-qwen2.5-vl-3b \
  --n-gpu-layers 0 \
  --no-mmproj-offload \
  --ctx-size 8192 \
  --threads 4 \
  --parallel 1 \
  --image-min-tokens 512 \
  --image-max-tokens 512 \
  --host 127.0.0.1 \
  --port 8781 \
  --api-key-file VISION_API_KEY_FILE
ExecStartPost=/usr/bin/bash -c 'until /usr/bin/curl --fail --silent --max-time 2 http://127.0.0.1:8781/health >/dev/null; do /usr/bin/sleep 2; done'
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=60

[Install]
WantedBy=default.target
