[Unit]
Description=Local AI Assistant Streamlit Interface
After=network.target llama-qwen.service
Requires=llama-qwen.service

[Service]
Type=simple
User=LOCAL_AI_USER
WorkingDirectory=REPOSITORY_DIR
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-REPOSITORY_DIR/.env
ExecStart=REPOSITORY_DIR/.venv/bin/streamlit run REPOSITORY_DIR/ui/streamlit/app.py \
  --server.address 127.0.0.1 \
  --server.port 8501 \
  --server.headless true \
  --browser.gatherUsageStats false
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
