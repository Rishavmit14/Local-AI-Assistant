# Compatibility profile for the reviewed MSI deployment. Copy values into a
# private .env only when intentionally migrating from the existing directories.
LOCAL_AI_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_AI_MODEL=/AI/models/qwen3.6-q4/Qwen3.6-35B-A3B-UD-Q4_K_M.gguf
LOCAL_AI_CONTEXT_SIZE=262144
LOCAL_AI_DOCUMENT_DIR=/AI/projects/local-ai/documents
LOCAL_AI_RAG_DATA_DIR=/AI/projects/local-ai/rag_data
LOCAL_AI_CODE_REPO_DIR=/AI/projects/code-assistant/repos
LOCAL_AI_CODE_INDEX_DIR=/AI/projects/code-assistant/index
LOCAL_AI_PATCH_DIR=/AI/projects/code-assistant/patches
LOCAL_AI_UI_HOST=127.0.0.1
LOCAL_AI_UI_PORT=8501
